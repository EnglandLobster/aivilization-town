{
  "name": "@aivilization/residents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/town.ts src/residentShell.ts src/writeSkill.ts --format esm --dts --clean && node dist/writeSkill.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "town": "node dist/town.js",
    "skill:generate": "node dist/writeSkill.js",
    "verify:cli": "node scripts/verify-cli.mjs",
    "verify:provider-outage": "node scripts/verify-provider-outage.mjs",
    "verify:experiment": "node scripts/verify-experiment.mjs",
    "verify:life": "node scripts/verify-life.mjs",
    "verify:life:opencode": "node scripts/verify-life-opencode.mjs",
    "verify:continuity": "node scripts/verify-continuity.mjs",
    "verify:service-supply": "node scripts/verify-service-supply.mjs",
    "verify:premises-rights": "node scripts/verify-premises-rights.mjs",
    "verify:premises-rights-activation": "node scripts/verify-premises-rights-activation.mjs",
    "verify:society-kernel": "node scripts/verify-society-kernel.mjs",
    "verify:program-conditions": "node scripts/verify-program-conditions.mjs",
    "verify:common-accounts": "node scripts/verify-common-accounts.mjs",
    "verify:collectives": "node scripts/verify-collectives.mjs",
    "verify:society-kernel:opencode": "node scripts/verify-society-kernel-opencode.mjs",
    "verify:resource-control": "node scripts/verify-resource-control.mjs",
    "verify:group-control": "node scripts/verify-group-control.mjs",
    "verify:material-production": "node scripts/verify-material-production.mjs",
    "verify:premises": "node scripts/verify-premises.mjs",
    "verify:facility-use": "node scripts/verify-facility-use.mjs",
    "verify:atomic-exchange": "node scripts/verify-atomic-exchange.mjs",
    "verify:public-housing": "node scripts/verify-public-housing.mjs",
    "verify:housing-occupancy": "node scripts/verify-housing-occupancy.mjs",
    "verify:housing-choice": "node scripts/verify-housing-choice.mjs",
    "verify:premises-principals": "node scripts/verify-premises-principals.mjs",
    "verify:physical-housing-rest": "node scripts/verify-physical-housing-rest.mjs",
    "verify:resource-sales": "node scripts/verify-resource-sales.mjs",
    "verify:resource-sales-v2": "node scripts/verify-resource-sales-v2.mjs"
  },
  "dependencies": {
    "@aivilization/agent-runtime": "workspace:*",
    "@aivilization/worker": "workspace:*",
    "opencode-ai": "1.18.31"
  },
  "bin": {
    "town": "./dist/town.js"
  },
  "devDependencies": {
    "@aivilization/memory": "workspace:*",
    "@aivilization/sim-core": "workspace:*",
    "@aivilization/world": "workspace:*"
  }
}
