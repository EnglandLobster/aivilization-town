{
  "name": "@aivilization/residents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/town.ts src/residentShell.ts src/writeSkill.ts --format esm --dts --clean && node dist/writeSkill.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "town": "node dist/town.js",
    "skill:generate": "node dist/writeSkill.js",
    "verify:cli": "node scripts/verify-cli.mjs",
    "verify:life": "node scripts/verify-life.mjs",
    "verify:life:opencode": "node scripts/verify-life-opencode.mjs",
    "verify:continuity": "node scripts/verify-continuity.mjs",
    "verify:service-supply": "node scripts/verify-service-supply.mjs",
    "verify:mobility": "node scripts/verify-mobility.mjs"
  },
  "dependencies": {
    "@aivilization/agent-runtime": "workspace:*",
    "@aivilization/worker": "workspace:*"
  },
  "bin": {
    "town": "./dist/town.js"
  }
}
