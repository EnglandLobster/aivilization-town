[Unit]
Description=AIvilization canonical town runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aivilization
Group=aivilization
WorkingDirectory=/opt/aivilization-town
EnvironmentFile=/etc/aivilization-town/runtime.env
ExecStart=/usr/bin/pnpm --filter @aivilization/server start -- --profile default-100 --root-dir /var/lib/aivilization-town --host 127.0.0.1 --port 3000
# Keep loopback behind a TLS reverse proxy. If this bind becomes non-loopback, authenticated access
# configuration is mandatory and the runtime fails closed without it.
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60s
# Reference deployment class: 4 vCPU, 4 GiB node memory, and a separately
# provisioned 25 GiB durable volume. Keep 25% node-memory headroom outside this service.
CPUQuota=400%
MemoryHigh=3G
MemoryMax=3G
TasksMax=512
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aivilization-town

[Install]
WantedBy=multi-user.target
