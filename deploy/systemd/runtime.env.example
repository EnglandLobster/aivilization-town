# Copy to /etc/aivilization-town/runtime.env with mode 0600. Never commit the real file.
AIVILIZATION_LLM_ENDPOINT=https://llm.example.invalid/v1/chat/completions
AIVILIZATION_LLM_MODEL=replace-with-deployed-model
AIVILIZATION_LLM_API_KEY=replace-with-secret
AIVILIZATION_LLM_INPUT_TOKEN_COST_MICROS=0
AIVILIZATION_LLM_OUTPUT_TOKEN_COST_MICROS=0

# LLM social signal extraction (cross-language/paraphrase social signal labeling) is enabled by
# default in provider mode. Set to off to keep deterministic keyword-only social adjudication.
# AIVILIZATION_SOCIAL_SIGNAL_EXTRACTION=off

# Required before binding a non-loopback host or accepting participant mutations through a proxy.
# Keep this file mode 0600: the JSON contains raw bootstrap credentials. Tokens must contain at least
# 32 random characters. The process converts them to SHA-256 digests during configuration parsing.
# AIVILIZATION_ACCESS_MODE=authenticated
# AIVILIZATION_MAX_AGENTS_PER_PARTICIPANT=16
# AIVILIZATION_ACCESS_CREDENTIALS_JSON=[{"keyId":"participant-primary","subjectId":"participant-1","token":"replace-with-at-least-32-random-characters","roles":["participant"]},{"keyId":"operator-primary","subjectId":"operator-1","token":"replace-with-another-32-character-secret","roles":["operator"]}]

# Production alternative to static credentials: configure an external OIDC provider. Do not set
# AIVILIZATION_ACCESS_CREDENTIALS_JSON at the same time. Issuer and JWKS URLs must use HTTPS.
# AIVILIZATION_OIDC_ISSUER=https://identity.example.com/
# AIVILIZATION_OIDC_AUDIENCE=aivilization-town
# AIVILIZATION_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AIVILIZATION_OIDC_ROLE_CLAIM=roles
# AIVILIZATION_OIDC_PARTICIPANT_ROLE=aivilization:participant
# AIVILIZATION_OIDC_OPERATOR_ROLE=aivilization:operator
# AIVILIZATION_OIDC_ALLOWED_ALGORITHMS=RS256
# AIVILIZATION_OIDC_CLOCK_TOLERANCE_SECONDS=5

# Required when the deployed artifact is not inside its Git worktree.
# AIVILIZATION_COMMIT=0123456789abcdef0123456789abcdef01234567
# AIVILIZATION_SOURCE_DIRTY=false
# If SOURCE_DIRTY=true, both values below are mandatory. Produce them from the exact packaged source
# using git-workspace-fingerprint-v1; do not reuse a digest from a different build context.
# AIVILIZATION_SOURCE_WORKSPACE_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# AIVILIZATION_SOURCE_WORKSPACE_PATH_COUNT=123

# Opt-in authoritative town weather (borrowed-mechanics adoption plan #1; not a paper mechanism).
# Disabled by default. Set to 1 to let the simulation-wide authority settle the town-weather-v1
# Markov chain during time advancement and expose current weather in the society projection.
# AIVILIZATION_TOWN_WEATHER=1

# Opt-in derived condition catalog (borrowed-mechanics adoption plan #2; not a paper mechanism).
# Disabled by default. Set to 1 to derive town-conditions-v1 (soaked/cold/overtired/hungry/stressed)
# into agent planning contexts and the society projection. Read-path only; pairs naturally with
# AIVILIZATION_TOWN_WEATHER=1 for the weather-exposure conditions.
# AIVILIZATION_TOWN_CONDITIONS=1
