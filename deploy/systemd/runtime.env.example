# Copy to /etc/aivilization-town/runtime.env with mode 0600. Never commit the real file.
AIVILIZATION_LLM_ENDPOINT=https://llm.example.invalid/v1/chat/completions
AIVILIZATION_LLM_MODEL=replace-with-deployed-model
AIVILIZATION_LLM_API_KEY=replace-with-secret
AIVILIZATION_LLM_INPUT_TOKEN_COST_MICROS=0
AIVILIZATION_LLM_OUTPUT_TOKEN_COST_MICROS=0

# LLM social signal extraction (cross-language/paraphrase social signal labeling) is enabled by
# default in provider mode. Set to off to keep deterministic keyword-only social adjudication.
# AIVILIZATION_SOCIAL_SIGNAL_EXTRACTION=off

# Required before binding a non-loopback host or accepting participant mutations through a proxy.
# Keep this file mode 0600: the JSON contains raw bootstrap credentials. Tokens must contain at least
# 32 random characters. The process converts them to SHA-256 digests during configuration parsing.
# AIVILIZATION_ACCESS_MODE=authenticated
# AIVILIZATION_MAX_AGENTS_PER_PARTICIPANT=16
# AIVILIZATION_ACCESS_CREDENTIALS_JSON=[{"keyId":"participant-primary","subjectId":"participant-1","token":"replace-with-at-least-32-random-characters","roles":["participant"]},{"keyId":"operator-primary","subjectId":"operator-1","token":"replace-with-another-32-character-secret","roles":["operator"]}]

# Production alternative to static credentials: configure an external OIDC provider. Do not set
# AIVILIZATION_ACCESS_CREDENTIALS_JSON at the same time. Issuer and JWKS URLs must use HTTPS.
# AIVILIZATION_OIDC_ISSUER=https://identity.example.com/
# AIVILIZATION_OIDC_AUDIENCE=aivilization-town
# AIVILIZATION_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AIVILIZATION_OIDC_ROLE_CLAIM=roles
# AIVILIZATION_OIDC_PARTICIPANT_ROLE=aivilization:participant
# AIVILIZATION_OIDC_OPERATOR_ROLE=aivilization:operator
# AIVILIZATION_OIDC_ALLOWED_ALGORITHMS=RS256
# AIVILIZATION_OIDC_CLOCK_TOLERANCE_SECONDS=5

# Required when the deployed artifact is not inside its Git worktree.
# AIVILIZATION_COMMIT=0123456789abcdef0123456789abcdef01234567
# AIVILIZATION_SOURCE_DIRTY=false
# If SOURCE_DIRTY=true, both values below are mandatory. Produce them from the exact packaged source
# using git-workspace-fingerprint-v1; do not reuse a digest from a different build context.
# AIVILIZATION_SOURCE_WORKSPACE_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# AIVILIZATION_SOURCE_WORKSPACE_PATH_COUNT=123

# Opt-in authoritative town weather (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to let the simulation-wide authority settle the town-weather-v1
# Markov chain during time advancement and expose current weather in the society projection.
# AIVILIZATION_TOWN_WEATHER=1

# Opt-in derived condition catalog (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to derive town-conditions-v1 (soaked/cold/overtired/hungry/stressed)
# into agent planning contexts and the society projection. Read-path only; pairs naturally with
# AIVILIZATION_TOWN_WEATHER=1 for the weather-exposure conditions.
# AIVILIZATION_TOWN_CONDITIONS=1

# Opt-in town bulletin board (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to let agents post bulletins and operators issue town bulletins
# against the authoritative board; high-priority bulletins preempt resident planning.
# AIVILIZATION_TOWN_BULLETIN=1

# Opt-in social matters state machine (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to escalate conversation commitments into town matters and enable
# help-request raise/respond/assign/close with world-verified fulfillment.
# AIVILIZATION_SOCIAL_MATTERS=1

# Opt-in town conflict system (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to enable AgentConfront/AgentAttack/AgentIntervene with
# world-issued grievances, deterministic damage, and witness fallout. Attacks incapacitate,
# never kill.
# AIVILIZATION_TOWN_CONFLICT=1

# Opt-in agent wellbeing state variable (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to settle the durable per-agent town-wellbeing-v1 scalar
# (physiology, employment, housing, lifestyle, arrears, distress, and social relation factors)
# during time advancement and expose it in agent planning contexts.
# AIVILIZATION_TOWN_WELLBEING=1

# Opt-in town day/night calendar (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to settle town-calendar-v1 phase transitions
# (night/dawn/day/dusk/evening) and the passive energy/satiety decay during time advancement.
# Phases are a pure function of the simulation clock, so every partition derives identical
# results. Pairs naturally with AIVILIZATION_TOWN_WELLBEING=1 so wellbeing reads decayed axes.
# AIVILIZATION_TOWN_CALENDAR=1

# Opt-in population lifecycle (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to settle town-lifecycle-v1 aging (adult -> elderly),
# forced retirement with a treasury-funded hourly pension, and pre-rolled-lifespan or
# illness deaths. Deaths liquidate the estate: enterprise jobs released, bank loans
# written off, deposits forfeited, and the circulating balance burned (moneySupply falls).
# Pairs naturally with AIVILIZATION_TOWN_CALENDAR=1 (shared day grid).
# AIVILIZATION_TOWN_LIFECYCLE=1

# Opt-in hearsay memory propagation (experimental; not a paper mechanism).
# Disabled by default. Set to 1 so each conversation direction can carry one of the
# speaker's recent memories to the listener as a hearsay copy: propagation probability
# 40%, importance re-rolled within x[0.7, 1.3], hearsay stops re-sharing after 3 hops.
# AIVILIZATION_TOWN_DISCOURSE=1

# Opt-in petition collective action (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to let agents raise/sign town petitions; signatures
# aggregate on the simulation-wide authority and crossing the threshold (3, raiser
# included) fires a town-wide PetitionThresholdReached. Open petitions expire after
# 3 simulation days. Strikes and other ledger-touching collective action are out of
# scope until their accounting impact is argued.
# AIVILIZATION_TOWN_COLLECTIVE_ACTION=1

# Opt-in happiness-driven out-migration (experimental; not a paper mechanism).
# Disabled by default. Set to 1 to roll the CS2 NotHappy departure rule per agent and
# cadence: persistently unhappy agents leave town with full estate liquidation (currency
# burned out of the town economy, moneySupply falls). Zero probability near wellbeing 48,
# capped at 1%/h. Requires AIVILIZATION_TOWN_WELLBEING=1 to be effective (fallback 50).
# AIVILIZATION_TOWN_MIGRATION=1

# Opt-in material-backed housing construction (experimental).
# At high town-wide occupancy, an eligible resident can consume Wood to expand
# finite residential capacity. Requires the simulation-wide authority.
# AIVILIZATION_TOWN_CONSTRUCTION=1

# Opt-in budget- and occupancy-driven service quality (experimental).
# Settled only by the simulation-wide authority; affects education, healthcare,
# wellbeing, and regional land value while enabled.
# AIVILIZATION_TOWN_SERVICE_QUALITY=1
# Enable replayable tax/public-budget/subsidy commands (default: off).
# AIVILIZATION_TOWN_GOVERNANCE=1
# Deterministic satiety-deficit health damage and starvation death (default off).
# AIVILIZATION_TOWN_SURVIVAL_PRESSURE=1
# AIVILIZATION_TOWN_CARRYING_CAPACITY=1
