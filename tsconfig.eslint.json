{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "eslint.config.js",
    "vitest.config.ts",
    "vitest.workspace-aliases.ts",
    "scripts/**/*.mjs",
    "apps/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.tsx"
  ]
}
